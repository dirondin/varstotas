{
    "version": "@VERSION@",
    "description": "3D modelling for makers: furniture, workshop projects and 3D prints, in real units",
    "homepage": "https://github.com/dirondin/varstotas",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dirondin/varstotas/releases/download/release-@VERSION@/Varstotas-@VERSION@-windows-x86_64.zip",
            "hash": "@SHA256_WINDOWS_ZIP@"
        },
        "arm64": {
            "url": "https://github.com/dirondin/varstotas/releases/download/release-@VERSION@/Varstotas-@VERSION@-windows-aarch64.zip",
            "hash": "@SHA256_WINDOWS_ARM_ZIP@"
        }
    },
    "bin": "varstotas.exe",
    "shortcuts": [
        [
            "varstotas.exe",
            "Varstotas"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/dirondin/varstotas/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "release-([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dirondin/varstotas/releases/download/release-$version/Varstotas-$version-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/dirondin/varstotas/releases/download/release-$version/Varstotas-$version-windows-aarch64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
