<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.dirondin.Varstotas</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Varstotas</name>
  <summary>3D modelling for makers</summary>
  <developer id="io.github.dirondin">
    <name>Michail Palubisak</name>
  </developer>

  <description>
    <p>
      Varstotas is a free, open-source 3D modeller for makers and hobbyists. Plan furniture,
      workshop projects and 3D prints in real millimetres, then take the dimensions to the
      workshop or the model to a slicer.
    </p>
    <ul>
      <li>Direct push/pull modelling with inference snapping and typed exact values</li>
      <li>Dimensions, text, groups, reusable components, tags, scenes and section planes</li>
      <li>Preparing models for 3D printing: checks and repair, wall thickness, cutting with dowels, STL and 3MF export</li>
      <li>Unfolding to SVG, PDF and DXF; sheets with scaled views</li>
      <li>PBR materials, a realistic real-time style and a GPU path tracer</li>
      <li>Rhai scripting, plugins, parametric generators and a local bridge for Python and AI agents</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.dirondin.Varstotas.desktop</launchable>
  <provides>
    <binary>varstotas</binary>
    <mediatype>application/x-varstotas</mediatype>
  </provides>

  <url type="homepage">https://github.com/dirondin/varstotas</url>
  <url type="bugtracker">https://github.com/dirondin/varstotas/issues</url>
  <url type="vcs-browser">https://github.com/dirondin/varstotas</url>

  <!-- the release tag's images (stable URLs); Release build checks the tag and the files -->
  <screenshots>
    <screenshot type="default">
      <caption>A workbench with its dimensions</caption>
      <image>https://raw.githubusercontent.com/dirondin/varstotas/release-0.2.0/docs/images/workbench.jpg</image>
    </screenshot>
    <screenshot>
      <caption>A desk caddy to 3D print, with its dimensions</caption>
      <image>https://raw.githubusercontent.com/dirondin/varstotas/release-0.2.0/docs/images/desk-caddy.jpg</image>
    </screenshot>
    <screenshot>
      <caption>Realistic materials: wood, metal, glass and light</caption>
      <image>https://raw.githubusercontent.com/dirondin/varstotas/release-0.2.0/docs/images/gallery.jpg</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
