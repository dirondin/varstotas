ansmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Copper","color":[0.95,0.62,0.52,1.0],"texture":null,"pbr":{"metallic":1.0,"roughness":0.28,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Chrome","color":[0.92,0.92,0.94,1.0],"texture":null,"pbr":{"metallic":1.0,"roughness":0.03,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Brushed Aluminium","color":[0.9,0.91,0.92,1.0],"texture":null,"pbr":{"metallic":1.0,"roughness":0.38,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Blue Titanium","color":[0.3,0.38,0.62,1.0],"texture":null,"pbr":{"metallic":1.0,"roughness":0.2,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Clear Glass","color":[0.96,0.98,0.98,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.0,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":1.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Ruby Glass","color":[0.85,0.08,0.14,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.0,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":1.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Frosted Glass","color":[0.9,0.95,1.0,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.35,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":1.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Reeded Glass","color":[0.9,0.96,0.93,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.02,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":1.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0,"shader":{"source":"// Reeded glass: vertical ribs that bend the reflections, a light tint.\n// @param pitch = 12 (2..100) \"Rib width (mm)\"\n// @param depth = 0.6 (0..2) \"Rib depth\"\n// @param frost = 0.08 (0..1) \"Frost\"\n// @param tint = 0.15 (0..1) \"Green tint\"\nfn surface(s: Surface, p: Params) -> Surface {\n    var o = s;\n    let u = (s.pos.x + s.pos.y) / p.pitch;\n    let slope = cos(fract(u) * 6.2831853) * p.depth;\n    o.normal = bump(s.normal, vec2<f32>(slope, 0.0));\n    o.base = mix(vec3<f32>(0.95), srgb(vec3<f32>(0.75, 0.9, 0.82)), p.tint);\n    o.roughness = 0.02 + p.frost * 0.5;\n    o.transmission = 1.0;\n    o.metallic = 0.0;\n    return o;\n}\n","params":[12.0,0.6,0.08,0.15]}}},"version":1},{"value":{"name":"Neon Pink","color":[1.0,0.25,0.6,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.4,"emission":[1.0,0.18,0.55],"emission_strength":10.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Neon Cyan","color":[0.2,0.9,1.0,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.4,"emission":[0.15,0.85,1.0],"emission_strength":10.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Glow Shader","color":[0.9,0.5,0.2,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.4,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0,"shader":{"source":"// Glow: a light panel that pulses slowly; optional grid lines.\n// @param hue = 0.08 (0..1) \"Hue\"\n// @param strength = 4 (0..30) \"Brightness\"\n// @param pulse = 0.3 (0..1) \"Pulse\"\n// @param lines = 0 (0..1) \"Grid lines\"\nfn surface(s: Surface, p: Params) -> Surface {\n    var o = s;\n    let wave = 1.0 - p.pulse * (0.5 + 0.5 * sin(s.time * 2.0));\n    let g = fract(s.uv / 250.0);\n    let line = max(step(g.x, 0.04), step(g.y, 0.04));\n    let k = mix(1.0, 1.0 - line * 0.85, p.lines);\n    o.emission = hsv(p.hue, 0.75, 1.0) * p.strength * wave * k;\n    o.base = vec3<f32>(0.05);\n    o.roughness = 0.4;\n    return o;\n}\n","params":[0.08,4.0,0.3,0.0]}}},"version":1},{"value":{"name":"Red Car Paint","color":[0.62,0.02,0.04,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.06,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Glossy Ceramic","color":[0.93,0.91,0.87,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.08,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Yellow Plastic","color":[0.95,0.68,0.05,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.32,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Rubber","color":[0.035,0.035,0.04,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.92,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0}},"version":1},{"value":{"name":"Water Shader","color":[0.1,0.35,0.45,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.04,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0,"shader":{"source":"// Water: moving waves (the normal follows the slope of a noise height field).\n// @param size = 400 (20..5000) \"Wave size (mm)\"\n// @param height = 0.4 (0..2) \"Wave height\"\n// @param speed = 0.6 (0..5) \"Speed\"\n// @param depth = 0.5 (0..1) \"Deep colour\"\nfn wave(x: vec2<f32>, t: f32) -> f32 {\n    return fbm(vec3<f32>(x + vec2<f32>(t * 0.3, t * 0.2), t * 0.25), 4);\n}\n\nfn surface(s: Surface, p: Params) -> Surface {\n    var o = s;\n    let x = s.pos.xy / p.size;\n    let t = s.time * p.speed;\n    let e = 0.02;\n    let h0 = wave(x, t);\n    let dh = vec2<f32>(wave(x + vec2<f32>(e, 0.0), t) - h0, wave(x + vec2<f32>(0.0, e), t) - h0) / e;\n    o.normal = bump(s.normal, dh * p.height * 0.25);\n    o.base = mix(srgb(vec3<f32>(0.25, 0.55, 0.6)), srgb(vec3<f32>(0.02, 0.12, 0.2)), p.depth);\n    o.roughness = 0.04;\n    o.metallic = 0.0;\n    return o;\n}\n","params":[400.0,0.4,0.6,0.5]}}},"version":1},{"value":{"name":"Wood Shader","color":[0.7,0.5,0.3,1.0],"texture":null,"pbr":{"metallic":0.0,"roughness":0.5,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0,"shader":{"source":"// Wood: growth rings around the red (X) axis and a fine grain along it.\n// @param spacing = 18 (3..120) \"Ring spacing (mm)\"\n// @param rings = 0.55 (0..1) \"Ring contrast\"\n// @param grain = 0.5 (0..1) \"Grain\"\n// @param tone = 0.35 (0..1) \"Light / dark wood\"\nfn surface(s: Surface, p: Params) -> Surface {\n    var o = s;\n    let q = s.pos;\n    let warp = fbm(vec3<f32>(q.x * 0.004, q.y * 0.02, q.z * 0.02), 3) * 3.0;\n    let r = length(q.yz) / p.spacing + warp;\n    let ring = smoothstep(0.0, 0.35, fract(r)) * (1.0 - smoothstep(0.75, 1.0, fract(r)));\n    let fine = noise(vec3<f32>(q.x * 0.01, q.y * 1.5, q.z * 1.5));\n    let light = mix(vec3<f32>(0.80, 0.62, 0.40), vec3<f32>(0.52, 0.33, 0.18), p.tone);\n    let dark = light * vec3<f32>(0.62, 0.55, 0.5);\n    var c = mix(light, dark, ring * p.rings);\n    c *= 1.0 - p.grain * 0.25 * fine;\n    o.base = srgb(c);\n    o.roughness = 0.5 + 0.2 * ring;\n    o.metallic = 0.0;\n    return o;\n}\n","params":[18.0,0.55,0.5,0.35]}}},"version":1},{"value":{"name":"Marble","color":[0.92273164,0.9133407,0.8800847,1.0],"texture":null,"image":{"bytes":"","pixels":[1024,1024],"size":[1600.0,1600.0],"file_name":"marble.jpg"},"pbr":{"metallic":0.0,"roughness":1.0,"emission":[0.0,0.0,0.0],"emission_strength":1.0,"transmission":0.0,"ior":1.5,"normal_scale":1.0,"clearcoat":0.0,"clearcoat_roughness":0.05,"sheen":0.0,"sheen_tint":0.5,"anisotropy":0.0,"anti_tiling":0.0,"bevel":0.0,"roughness_map":{"bytes":"","pixels":[1024,1024],"size":[1600.0,1600.0],"file_name":"marble_rough.jpg"}}},"version":1},{"value":{"name":"Walnut","color":[0.3457176,0.21801148,0.12657891,1.0],"textur